# Local development only. No real values belong in this template.
# Frontend accepts only a publishable key; server secrets must never use VITE_.
FORMANGLE_REPOSITORY=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Edge Functions receive SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY from Supabase. Never commit their values.
FORMANGLE_APP_ORIGIN=http://localhost:5173
